# Discord Claude Code Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Discord bot token from the Developer Portal (Bot → Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Discord application ID from the Developer Portal (General Information → Application ID)
DISCORD_APP_ID=your_application_id_here

# Test guild ID for guild-specific slash command registration (right-click guild → Copy ID)
DISCORD_GUILD_ID=your_test_guild_id_here

# pino log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Override config directory (default: ~/.discord-claude)
# CONFIG_DIR=/custom/config/path
